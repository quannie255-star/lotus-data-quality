# 数据目录：忽略内容，但保留 README（目录结构进 git）
data/raw/*
data/staging/*
data/curated/*
!data/*/README.md

# 运行期状态（审计日志 runs.jsonl、first_seen 台账）：本地产物，不进 git
data/meta/*
!data/meta/README.md

# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# 密钥与环境（HF token、S3 凭据等绝不进 git）
.env
*.env

# 系统 / 编辑器
.DS_Store
Thumbs.db

# 大体积二进制依赖（JDBC 驱动 / Hadoop AWS 相关 jar）：不入库
# 获取方式见 docker/metastore/README.md，boot 前需手工下载一次
docker/**/*.jar

# 阶段产物与运行时快照（manifest 台账同样不入库——本机可重算）
data/clean/
data/dedup/
data/quality/
data/mix/
data/release/
data/.clean.configs/
data/.dedup.configs/
data/*.staging.jsonl
data/meta/
data/models/
data/clip/flickr8k/
data/clip/*.zip
data/downstream/lora_anchor_phi0/
data/.*.configs/
data/*_run.json
data/*_err.log
data/chain_log.txt

# 本地临时目录（pip/pytest 落盘产物）
pip-*/
pytest-of-*/
data/clip/zh_pairs/
